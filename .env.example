# Copy this file to .env and fill in your own values.
# Never commit real keys.

# Public site origin, no trailing slash. Used for Open Graph tags and absolute links.
# Vite exposes this to the browser as import.meta.env.VITE_SITE_URL.
VITE_SITE_URL=https://stackd.example

# Supabase (required for live data and sign-in)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Google Maps (optional — used by src/services/googleMapsService.ts)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Edge functions read these from the Supabase secret store, not from the Vite bundle.
# SITE_URL is the same public origin, used for CORS and auth redirects.
# SITE_URL=https://stackd.example
# AI_GATEWAY_URL=https://api.openai.com/v1/chat/completions
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=gpt-4o-mini
